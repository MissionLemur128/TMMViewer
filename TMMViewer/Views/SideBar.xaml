<UserControl x:Class="TMMViewer.Views.SideBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMMViewer.Views"
             xmlns:pt="http://propertytools.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Import" Grid.Column="0" Command="{Binding ImportModelCommand}"/>
            <Button Content="Export" Grid.Column="1" Command="{Binding ExportModelCommand}"/>
        </Grid>

        <Label DockPanel.Dock="Top">
           Scene Tree:
        </Label>

        <pt:TreeListBox HierarchySource="{Binding SceneNodes}">

            <pt:TreeListBox.ItemTemplate>
                <HierarchicalDataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                        <CheckBox IsChecked="{Binding IsVisible}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </pt:TreeListBox.ItemTemplate>
        </pt:TreeListBox>
    </DockPanel>
</UserControl>
